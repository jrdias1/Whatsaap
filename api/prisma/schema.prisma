  idempotencyKey String         @db.VarChar(100)
  quantity       Int
  actorUserId    String         @db.Uuid
  createdAt      DateTime       @default(now())
  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  reward         ReferralReward @relation(fields: [tenantId, rewardId], references: [tenantId, id], onDelete: Restrict)
  unit           Unit           @relation(fields: [tenantId, unitId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, rewardId, createdAt])
}

model Automation {
  id                  String                @id @default(uuid()) @db.Uuid
  tenantId            String                @db.Uuid
  name                String
  trigger             String
  status              AutomationStatus      @default(DRAFT)
  configuration       Json
  createdById         String?               @db.Uuid
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  tenant              Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy           User?                 @relation("AutomationCreator", fields: [createdById], references: [id], onDelete: SetNull)
  executions          AutomationExecution[]
  satisfactionSurveys SatisfactionSurvey[]
  tasks               Task[]

  @@unique([tenantId, id])
  @@index([tenantId, status])
}

model AutomationExecution {
  id                 String              @id @default(uuid()) @db.Uuid
  tenantId           String              @db.Uuid
  unitId             String              @db.Uuid
  automationId       String              @db.Uuid
  appointmentId      String              @db.Uuid
  patientId          String              @db.Uuid
  idempotencyKey     String
  stepKey            String?             @db.VarChar(80)
  status             String              @default("PENDING") @db.VarChar(24)
  scheduledAt        DateTime
  responseDeadlineAt DateTime?
  executedAt         DateTime?
  outboxMessageId    String?             @db.Uuid
  responseAction     String?             @db.VarChar(32)
  attempts           Int                 @default(0)
  lastError          String?             @db.VarChar(500)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unit               Unit                @relation(fields: [tenantId, unitId], references: [tenantId, id], onDelete: Cascade)
  automation         Automation          @relation(fields: [tenantId, automationId], references: [tenantId, id], onDelete: Cascade)
  appointment        Appointment         @relation(fields: [tenantId, unitId, appointmentId], references: [tenantId, unitId, id], onDelete: Cascade)
  patient            Patient             @relation(fields: [tenantId, patientId], references: [tenantId, id], onDelete: Cascade)
  satisfactionSurvey SatisfactionSurvey?

  @@unique([tenantId, id])
  @@unique([tenantId, idempotencyKey])
  @@index([status, scheduledAt, id])
  @@index([tenantId, unitId, appointmentId, status])
  @@index([tenantId, automationId, scheduledAt])
}

model SatisfactionSurvey {
  id                String                      @id @default(uuid()) @db.Uuid
  tenantId          String                      @db.Uuid
  unitId            String                      @db.Uuid
  automationId      String                      @db.Uuid
  executionId       String                      @unique @db.Uuid
  appointmentId     String                      @db.Uuid
  patientId         String                      @db.Uuid
  procedureId       String?                     @db.Uuid
  channel           ConsentChannel              @default(WHATSAPP)
  provider          String
  question          String                      @db.VarChar(1000)
  version           Int                         @default(1)
  state             SatisfactionSurveyState     @default(PENDING)
  classification    SatisfactionClassification?
  responseSource    String?                     @db.VarChar(40)
  responseMessageId String?                     @db.VarChar(200)
  respondedAt       DateTime?
  expiresAt         DateTime
  outboxMessageId   String?                     @db.Uuid
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt
  tenant            Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unit              Unit                        @relation(fields: [tenantId, unitId], references: [tenantId, id], onDelete: Cascade)
  automation        Automation                  @relation(fields: [tenantId, automationId], references: [tenantId, id], onDelete: Cascade)
  execution         AutomationExecution         @relation(fields: [tenantId, executionId], references: [tenantId, id], onDelete: Cascade)
  appointment       Appointment                 @relation(fields: [tenantId, unitId, appointmentId], references: [tenantId, unitId, id], onDelete: Cascade)
  patient           Patient                     @relation(fields: [tenantId, patientId], references: [tenantId, id], onDelete: Cascade)
  procedure         Procedure?                  @relation(fields: [tenantId, procedureId], references: [tenantId, id], onDelete: Restrict)
  events            SatisfactionSurveyEvent[]

  @@unique([tenantId, id])
  @@unique([tenantId, executionId])
  @@unique([tenantId, automationId, appointmentId])
  @@index([tenantId, unitId, state, expiresAt])
  @@index([tenantId, patientId, state, expiresAt])
}

model SatisfactionSurveyEvent {
  id         String             @id @default(uuid()) @db.Uuid
  tenantId   String             @db.Uuid
  surveyId   String             @db.Uuid
  event      String             @db.VarChar(40)
  metadata   Json?
  occurredAt DateTime           @default(now())
  tenant     Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  survey     SatisfactionSurvey @relation(fields: [tenantId, surveyId], references: [tenantId, id], onDelete: Cascade)

  @@index([tenantId, surveyId, occurredAt])
}

model NpsSettings {
  id                   String   @id @default(uuid()) @db.Uuid
  tenantId             String   @unique @db.Uuid
  enabled              Boolean  @default(false)
  unitId               String?  @db.Uuid
  eligibleProcedureIds Json?
  delayHours           Int      @default(24)
  question             String   @default("De 0 a 10, o quanto voce recomendaria nossa clinica?") @db.VarChar(1000)
  allowComment         Boolean  @default(true)
  repeatAfterDays      Int      @default(0)
  windowStartMinute    Int      @default(480)
  windowEndMinute      Int      @default(1200)
  createFollowupBelow  Int?
  followupDueHours     Int      @default(24)
  responsibleUserId    String?  @db.Uuid
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  tenant               Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, enabled, unitId])
}

model NpsSurvey {
  id                String      @id @default(uuid()) @db.Uuid
  tenantId          String      @db.Uuid
  unitId            String      @db.Uuid
  appointmentId     String      @db.Uuid
  patientId         String      @db.Uuid
  scheduledAt       DateTime
  status            String      @default("PLANNED") @db.VarChar(24)
  question          String      @db.VarChar(1000)
  allowComment      Boolean     @default(true)
  score             Int?
  comment           String?     @db.VarChar(2000)
  responseSource    String?     @db.VarChar(40)
  respondedByUserId String?     @db.Uuid
  respondedAt       DateTime?
  followupTaskId    String?     @unique @db.Uuid
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  tenant            Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unit              Unit        @relation(fields: [tenantId, unitId], references: [tenantId, id], onDelete: Cascade)
  appointment       Appointment @relation(fields: [tenantId, unitId, appointmentId], references: [tenantId, unitId, id], onDelete: Cascade)
  patient           Patient     @relation(fields: [tenantId, patientId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@unique([tenantId, appointmentId])
  @@index([tenantId, unitId, scheduledAt, status])
  @@index([tenantId, patientId, respondedAt])
}

model OutboxMessage {
  id                String          @id @default(uuid()) @db.Uuid
  tenantId          String          @db.Uuid
  patientId         String          @db.Uuid
  campaignId        String?         @db.Uuid
  purpose           ConsentPurpose
  channel           ConsentChannel
  provider          String
  connectionId      String?         @db.Uuid
  body              String
  idempotencyKey    String
  status            OutboxStatus    @default(PENDING)
  suppressionReason String?
  attempts          Int             @default(0)
  enqueuedAt        DateTime?
  leaseExpiresAt    DateTime?
  nextAttemptAt     DateTime        @default(now())
  lastError         String?         @db.VarChar(500)
  scheduledAt       DateTime        @default(now())
  sentAt            DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @default(now()) @updatedAt
  tenant            Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient           Patient         @relation(fields: [tenantId, patientId], references: [tenantId, id], onDelete: Cascade)
  campaign          Campaign?       @relation(fields: [tenantId, campaignId], references: [tenantId, id], onDelete: Cascade)
  attemptsLog       OutboxAttempt[]

  @@unique([tenantId, idempotencyKey])
  @@unique([tenantId, id])
  @@index([tenantId, status, scheduledAt])
  @@index([status, nextAttemptAt, scheduledAt])
}

model OutboxAttempt {
  id                String               @id @default(uuid()) @db.Uuid
  tenantId          String               @db.Uuid
  outboxMessageId   String               @db.Uuid
  attemptNumber     Int
  outcome           OutboxAttemptOutcome
  cause             String               @db.VarChar(120)
  detail            String?              @db.VarChar(500)
  nextAction        String               @db.VarChar(120)
  providerReference String?
  queueLatencyMs    Int?
  processingMs      Int?
  createdAt         DateTime             @default(now())
  tenant            Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  outboxMessage     OutboxMessage        @relation(fields: [tenantId, outboxMessageId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, outboxMessageId, attemptNumber])
  @@index([tenantId, outcome, createdAt])
}

// Provider-side receipt for the local simulator only; no external API is called.
model DryRunProviderReceipt {
  id                String   @id @default(uuid()) @db.Uuid
  tenantId          String   @db.Uuid
  idempotencyKey    String
  outboxMessageId   String   @db.Uuid
  providerReference String   @unique
  acceptedAt        DateTime @default(now())
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, outboxMessageId])
}

model Plan {
  id                    String         @id @default(uuid()) @db.Uuid
  code                  String         @unique
  name                  String
  priceCents            Int
  patientLimit          Int?
  messageLimitPerCycle  Int
  userLimit             Int
  unitLimit             Int
  connectionLimit       Int
  activeAutomationLimit Int
  campaignLimitPerCycle Int
  enabled               Boolean        @default(true)
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  subscriptions         Subscription[]
}

model Subscription {
  id             String             @id @default(uuid()) @db.Uuid
  tenantId       String             @unique @db.Uuid
  planId         String             @db.Uuid
  status         SubscriptionStatus @default(TRIAL)
  cycleStartsAt  DateTime
  cycleEndsAt    DateTime
  limitOverrides Json?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  tenant         Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan           Plan               @relation(fields: [planId], references: [id], onDelete: Restrict)
  usageEntries   UsageEntry[]

  @@index([status, cycleEndsAt])
}

model UsageEntry {
  id             String       @id @default(uuid()) @db.Uuid
  subscriptionId String       @db.Uuid
  tenantId       String       @db.Uuid
  metric         String
  quantity       Int          @default(1)
  idempotencyKey String
  cycleStartsAt  DateTime
  cycleEndsAt    DateTime
  createdAt      DateTime     @default(now())
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([tenantId, metric, idempotencyKey])
  @@index([tenantId, metric, cycleStartsAt, cycleEndsAt])
}

model AuditEvent {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String?  @db.Uuid
  actorUserId String?  @db.Uuid
  action      String
  entityType  String
  entityId    String?
  metadata    Json     @default("{}")
  occurredAt  DateTime @default(now())
  tenant      Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  actor       User?    @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, occurredAt])
  @@index([actorUserId, occurredAt])
  @@index([entityType, entityId])
}
