generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TenantStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  CLOSED
}

enum UserRole {
  PLATFORM_SUPERADMIN
  TENANT_ADMIN
  UNIT_MANAGER
  OPERATOR
}

enum MembershipStatus {
  INVITED
  ACTIVE
  DISABLED
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELED
}

enum ConsentChannel {
  WHATSAPP
  EMAIL
  SMS
}

enum ConsentPurpose {
  MARKETING
  POST_CARE
  APPOINTMENT_REMINDER
  SATISFACTION_SURVEY
  PROCEDURE_RETURN
}

enum ReferralQualificationCriterion {
  LEAD_REGISTERED
  FIRST_NATIVE_APPOINTMENT_COMPLETED
}

enum ReferralCampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  ENDED
}

enum ReferralStatus {
  CLICKED
  LEAD_REGISTERED
  PATIENT_LINKED
  QUALIFIED
  CONVERTED
  PENDING_VERIFICATION
  REJECTED
  CANCELLED
  REVERSED
}

enum ReferralRewardType {
  VOUCHER
  SESSION_CREDIT
  DISCOUNT
  SERVICE
}

enum ReferralRewardStatus {
  PENDING_APPROVAL
  APPROVED
  ISSUED
  PARTIALLY_USED
  USED
  EXPIRED
  CANCELLED
  REJECTED
}

enum SatisfactionClassification {
  EXCELLENT
  GOOD
  REGULAR
  POOR
  VERY_POOR
}

enum SatisfactionSurveyState {
  PENDING
  OUTBOXED
  RESPONDED
  EXPIRED
  SUPPRESSED
  FAILED
}

enum ConsentStatus {
  GRANTED
  DENIED
  REVOKED
}

enum ConsentSource {
  MANUAL
  IMPORT
  WHATSAPP_INBOUND
  API
}

enum ConsentEvidenceType {
  SIGNED_DOCUMENT
  WRITTEN_FORM
  WHATSAPP_MESSAGE
  EMAIL_MESSAGE
  OTHER
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  NO_SHOW
  CANCELLED
}

enum AppointmentSource {
  NATIVE
  UNO
  MANUAL_IMPORT
}

enum UnitResourceType {
  PROFESSIONAL
  ROOM
  EQUIPMENT
}

enum IntegrationStatus {
  DISCONNECTED
  CONNECTED
  ERROR
}

enum MessagingProvider {
  META_CLOUD
  EVOLUTION_BAILEYS
  EVOLUTION_CLOUD
}

enum ConversationStatus {
  OPEN
  WAITING_HUMAN
  CLOSED
}

enum ConversationAssignmentAction {
  CLAIMED
  ASSIGNED
  TRANSFERRED
  RELEASED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageActor {
  HUMAN
  AI
  SYSTEM
  PATIENT
}

enum MessageOrigin {
  HUMAN
  AI_DRAFT_HUMAN_APPROVED
  SYSTEM
}

enum MessageStatus {
  RECEIVED
  QUEUED
  SIMULATED
  SENT
  DELIVERED
  READ
  FAILED
  SUPPRESSED
}

enum CampaignStatus {
  DRAFT
  APPROVED
  SCHEDULED
  RUNNING
  PAUSED
  COMPLETED
  CANCELLED
}

enum AutomationStatus {
  DRAFT
  ACTIVE
  PAUSED
}

enum OutboxStatus {
  PENDING
  PROCESSING
  RETRY
  UNKNOWN
  SIMULATED
  SENT
  FAILED
  SUPPRESSED
}

enum OutboxAttemptOutcome {
  ACCEPTED
  RETRYABLE_FAILURE
  PERMANENT_FAILURE
  UNKNOWN
  SUPPRESSED
}

enum AiDraftStatus {
  PENDING
  APPROVED
  REJECTED
}

model AuthSession {
  id           String     @id @default(uuid()) @db.Uuid
  tenantId     String     @db.Uuid
  userId       String     @db.Uuid
  membershipId String     @db.Uuid
  tokenHash    String     @unique
  expiresAt    DateTime
  revokedAt    DateTime?
  lastUsedAt   DateTime?
  createdAt    DateTime   @default(now())
  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId, revokedAt])
  @@index([expiresAt])
}

model UserInvitation {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @db.Uuid
  email       String
  displayName String
  role        UserRole
  unitIds     String[]  @default([])
  tokenHash   String    @unique
  invitedById String    @db.Uuid
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invitedBy   User      @relation("InvitationActor", fields: [invitedById], references: [id], onDelete: Restrict)

  @@index([tenantId, email, acceptedAt])
  @@index([expiresAt])
}

model PasswordRecoveryToken {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @db.Uuid
  userId      String    @db.Uuid
  tokenHash   String    @unique
  createdById String    @db.Uuid
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user        User      @relation("RecoveryTarget", fields: [userId], references: [id], onDelete: Cascade)
  createdBy   User      @relation("RecoveryIssuer", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([tenantId, userId, usedAt, expiresAt])
}

enum PrivacyRequestStatus {
  OPEN
  UNDER_REVIEW
  COMPLETED
  REJECTED
}

enum PrivacyRequestType {
  ACCESS
  CORRECTION
  EXPORT
  CONSENT_REVIEW
  ERASURE
  ANONYMIZATION
  DATA_USE_QUESTION
}

model PrivacyRequest {
  id            String                @id @default(uuid()) @db.Uuid
  tenantId      String                @db.Uuid
  patientId     String                @db.Uuid
  type          PrivacyRequestType
  reason        String
  status        PrivacyRequestStatus  @default(OPEN)
  closureReason String?
  createdById   String                @db.Uuid
  assignedToId  String?               @db.Uuid
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  tenant        Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient       Patient               @relation(fields: [tenantId, patientId], references: [tenantId, id], onDelete: Restrict)
  createdBy     User                  @relation("PrivacyRequestCreator", fields: [createdById], references: [id], onDelete: Restrict)
  assignedTo    User?                 @relation("PrivacyRequestAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  events        PrivacyRequestEvent[]

  @@unique([tenantId, id])
  @@index([tenantId, status, createdAt])
  @@index([tenantId, patientId, createdAt])
}

model PrivacyRequestEvent {
  id               String         @id @default(uuid()) @db.Uuid
  tenantId         String         @db.Uuid
  privacyRequestId String         @db.Uuid
  actorUserId      String         @db.Uuid
  action           String
  details          Json           @default("{}")
  occurredAt       DateTime       @default(now())
  tenant           Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  request          PrivacyRequest @relation(fields: [tenantId, privacyRequestId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, privacyRequestId, occurredAt])
}

model Tenant {
  id                       String                    @id @default(uuid()) @db.Uuid
  name                     String
  displayName              String?
  legalName                String?
  contactEmail             String?
  contactPhone             String?
  address                  String?
  accentColor              String?
  secondaryColor           String?
  institutionalText        String?
  slug                     String                    @unique
  status                   TenantStatus              @default(TRIAL)
  timezone                 String                    @default("America/Sao_Paulo")
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  provisioningKey          String?                   @unique
  units                    Unit[]
  memberships              Membership[]
  subscription             Subscription?
  auditEvents              AuditEvent[]
  sessions                 AuthSession[]
  invitations              UserInvitation[]
  patients                 Patient[]
  procedures               Procedure[]
  appointments             Appointment[]
  unoConnections           UnoConnection[]
  conversations            Conversation[]
  messages                 Message[]
  campaigns                Campaign[]
  automations              Automation[]
  automationExecutions     AutomationExecution[]
  satisfactionSurveys      SatisfactionSurvey[]
  satisfactionSurveyEvents SatisfactionSurveyEvent[]
  outbox                   OutboxMessage[]
  unoEvents                UnoEvent[]
  consents                 ConsentPreference[]
  consentEvents            ConsentEvent[]
  conversationStages       ConversationStage[]
  stageCampaignEnrollments StageCampaignEnrollment[]
  conversationAssignments  ConversationAssignment[]
  tasks                    Task[]
  taskHistory              TaskHistory[]
  aiSettings               AiSettings?
  aiDrafts                 AiDraft[]
  patientTags              PatientTagDefinition[]
  patientNotes             PatientNote[]
  patientDocuments         PatientDocument[]
  quickReplies             QuickReply[]
  metaConnections          MetaConnection[]
  evolutionConnections     EvolutionConnection[]
  evolutionWebhookEvents   EvolutionWebhookEvent[]
  metaWebhookEvents        MetaWebhookEvent[]
  outboxAttempts           OutboxAttempt[]
  dryRunProviderReceipts   DryRunProviderReceipt[]
  referralCampaigns        ReferralCampaign[]
  referralParticipants     ReferralParticipant[]
  referrals                Referral[]
  referralEvents           ReferralEvent[]
  referralRewards          ReferralReward[]
  referralRewardUses       ReferralRewardUse[]
  resources                UnitResource[]
  npsSettings              NpsSettings?
  npsSurveys               NpsSurvey[]
  passwordRecoveryTokens   PasswordRecoveryToken[]
  privacyRequests          PrivacyRequest[]
  privacyRequestEvents     PrivacyRequestEvent[]
}

model Unit {
  id                   String                  @id @default(uuid()) @db.Uuid
  tenantId             String                  @db.Uuid
  name                 String
  slug                 String
  contactEmail         String?
  contactPhone         String?
  address              String?
  active               Boolean                 @default(true)
  scheduleEnabled      Boolean                 @default(false)
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  tenant               Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberships          UnitMembership[]
  patients             Patient[]
  procedures           Procedure[]
  appointments         Appointment[]
  unoConnections       UnoConnection[]
  conversations        Conversation[]
  tasks                Task[]
  metaConnections      MetaConnection[]
  evolutionConnections EvolutionConnection[]
  automationExecutions AutomationExecution[]
  satisfactionSurveys  SatisfactionSurvey[]
  npsSurveys           NpsSurvey[]
  referralCampaigns    ReferralCampaignUnit[]
  referralParticipants ReferralParticipant[]
  referrals            Referral[]
  referralRewards      ReferralReward[]
  referralRewardUses   ReferralRewardUse[]
  resources            UnitResource[]
  workingIntervals     UnitWorkingInterval[]
  scheduleExceptions   UnitScheduleException[]
  scheduleBlocks       UnitScheduleBlock[]

  @@unique([tenantId, slug])
  @@unique([tenantId, id])
  @@index([tenantId, active])
}

model User {
  id                           String                   @id @default(uuid()) @db.Uuid
  email                        String                   @unique
  passwordHash                 String
  displayName                  String
  mustChangePassword           Boolean                  @default(false)
  active                       Boolean                  @default(true)
  createdAt                    DateTime                 @default(now())
  updatedAt                    DateTime                 @updatedAt
  platformAdminIdentity        PlatformAdminIdentity?
  memberships                  Membership[]
  auditEvents                  AuditEvent[]             @relation("AuditActor")
  sessions                     AuthSession[]
  sentInvitations              UserInvitation[]         @relation("InvitationActor")
  recoveryTokens               PasswordRecoveryToken[]  @relation("RecoveryIssuer")
  passwordRecoveryTokens       PasswordRecoveryToken[]  @relation("RecoveryTarget")
  createdPrivacyRequests       PrivacyRequest[]         @relation("PrivacyRequestCreator")
  assignedPrivacyRequests      PrivacyRequest[]         @relation("PrivacyRequestAssignee")
  consentChanges               ConsentEvent[]           @relation("ConsentActor")
  patientNotes                 PatientNote[]            @relation("PatientNoteAuthor")
  uploadedPatientDocuments     PatientDocument[]        @relation("PatientDocumentUploader")
  assignedConversations        Conversation[]           @relation("ConversationAssignee")
  conversationAssignmentEvents ConversationAssignment[] @relation("ConversationAssignmentActor")
  assignedTasks                Task[]                   @relation("TaskAssignee")
  createdTasks                 Task[]                   @relation("TaskCreator")
  taskHistoryEvents            TaskHistory[]            @relation("TaskHistoryActor")
  createdQuickReplies          QuickReply[]             @relation("QuickReplyCreator")
  updatedQuickReplies          QuickReply[]             @relation("QuickReplyUpdater")
  createdAutomations           Automation[]             @relation("AutomationCreator")
  createdReferralCampaigns     ReferralCampaign[]       @relation("ReferralCampaignCreator")
  approvedReferralRewards      ReferralReward[]         @relation("ReferralRewardApprover")
  issuedReferralRewards        ReferralReward[]         @relation("ReferralRewardIssuer")
}

// An explicit global identity is required in addition to the membership role.
// Ordinary tenant administrators cannot create or modify this record.
model PlatformAdminIdentity {
  userId              String   @id @db.Uuid
  totpSecretEncrypted String
  lastTotpStep        BigInt   @default(0)
  createdAt           DateTime @default(now())
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Membership {
  id         String           @id @default(uuid()) @db.Uuid
  tenantId   String           @db.Uuid
  userId     String           @db.Uuid
  role       UserRole
  status     MembershipStatus @default(ACTIVE)
  createdAt  DateTime         @default(now())
  tenant     Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  unitScopes UnitMembership[]
  sessions   AuthSession[]

  @@unique([tenantId, userId])
  @@unique([tenantId, id])
  @@index([userId, status])
}

model UnitMembership {
  tenantId     String     @db.Uuid
  membershipId String     @db.Uuid
  unitId       String     @db.Uuid
  membership   Membership @relation(fields: [tenantId, membershipId], references: [tenantId, id], onDelete: Cascade)
  unit         Unit       @relation(fields: [tenantId, unitId], references: [tenantId, id], onDelete: Cascade)

  @@id([membershipId, unitId])
  @@index([tenantId, membershipId])
  @@index([unitId])
}

model Patient {
  id                     String                @id @default(uuid()) @db.Uuid
  tenantId               String                @db.Uuid
  unitId                 String?               @db.Uuid
  fullName               String
  phone                  String?
  phoneNormalized        String?
  email                  String?
  birthDate              DateTime?
  source                 String?
  active                 Boolean               @default(true)
  deletedAt              DateTime?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  tenant                 Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unit                   Unit?                 @relation(fields: [tenantId, unitId], references: [tenantId, id], onDelete: Restrict)
  consents               ConsentPreference[]
  consentEvents          ConsentEvent[]
  appointments           Appointment[]
  automationExecutions   AutomationExecution[]
  satisfactionSurveys    SatisfactionSurvey[]
  npsSurveys             NpsSurvey[]
  privacyRequests        PrivacyRequest[]
  conversations          Conversation[]
  tasks                  Task[]
  outbox                 OutboxMessage[]
  tags                   PatientTag[]
  notes                  PatientNote[]
  documents              PatientDocument[]
  referralParticipations ReferralParticipant[]
  referralsMade          Referral[]            @relation("ReferralIndicator")
  referredRecords        Referral[]            @relation("ReferralPatient")

  @@unique([tenantId, id])
  @@index([tenantId, fullName])
  @@index([tenantId, phoneNormalized])
  @@index([tenantId, unitId, active])
}

model PatientTagDefinition {
  id        String       @id @default(uuid()) @db.Uuid
  tenantId  String       @db.Uuid
  name      String
  color     String       @default("#64748b")
  createdAt DateTime     @default(now())
  tenant    Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patients  PatientTag[]

  @@unique([tenantId, id])
  @@unique([tenantId, name])
  @@index([tenantId, name])
}

model PatientTag {
  tenantId  String               @db.Uuid
  patientId String               @db.Uuid
  tagId     String               @db.Uuid
  createdAt DateTime             @default(now())
  patient   Patient              @relation(fields: [tenantId, patientId], references: [tenantId, id], onDelete: Cascade)
  tag       PatientTagDefinition @relation(fields: [tenantId, tagId], references: [tenantId, id], onDelete: Cascade)

  @@id([tenantId, patientId, tagId])
  @@index([tenantId, tagId])
}

model PatientNote {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @db.Uuid
  patientId    String   @db.Uuid
  authorUserId String   @db.Uuid
  content      String
  createdAt    DateTime @default(now())
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient      Patient  @relation(fields: [tenantId, patientId], references: [tenantId, id], onDelete: Cascade)
  author       User     @relation("PatientNoteAuthor", fields: [authorUserId], references: [id], onDelete: Restrict)

  @@index([tenantId, patientId, createdAt])
}

model PatientDocument {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @db.Uuid
  patientId        String   @db.Uuid
  uploadedByUserId String?  @db.Uuid
  originalName     String   @db.VarChar(180)
  mimeType         String   @db.VarChar(80)
  size             Int
  storageKey       String   @unique @db.VarChar(80)
  createdAt        DateTime @default(now())
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient          Patient  @relation(fields: [tenantId, patientId], references: [tenantId, id], onDelete: Cascade)
  uploadedBy       User?    @relation("PatientDocumentUploader", fields: [uploadedByUserId], references: [id], onDelete: SetNull)

  @@unique([tenantId, id])
  @@index([tenantId, patientId, createdAt])
}

model QuickReply {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  name        String   @db.VarChar(100)
  description String?  @db.VarChar(240)
  shortcut    String?  @db.VarChar(40)
  category    String   @db.VarChar(60)
  body        String   @db.VarChar(4000)
  active      Boolean  @default(true)
  createdById String   @db.Uuid
  updatedById String   @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy   User     @relation("QuickReplyCreator", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy   User     @relation("QuickReplyUpdater", fields: [updatedById], references: [id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, shortcut])
  @@index([tenantId, active, category, name])
}

model MetaConnection {
  id                   String             @id @default(uuid()) @db.Uuid
  tenantId             String             @db.Uuid
  unitId               String             @db.Uuid
  displayName          String             @default("Meta Cloud")
  wabaId               String
  phoneNumberId        String             @unique
  graphApiVersion      String             @default("UNCONFIRMED")
  accessTokenEncrypted String
  status               IntegrationStatus  @default(DISCONNECTED)
  enabled              Boolean            @default(true)
  isDefault            Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  tenant               Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unit                 Unit               @relation(fields: [tenantId, unitId], references: [tenantId, id], onDelete: Cascade)
  events               MetaWebhookEvent[]

  @@unique([tenantId, id])
  @@index([tenantId, status])
}

model EvolutionConnection {
  id                String                  @id @default(uuid()) @db.Uuid
  tenantId          String                  @db.Uuid
  unitId            String                  @db.Uuid
  displayName       String
  apiBaseUrl        String
  instanceName      String
  mode              MessagingProvider       @default(EVOLUTION_BAILEYS)
  apiVersion        String                  @default("UNCONFIRMED")
  apiKeyEncrypted   String
  webhookSecretHash String                  @unique
  phoneNumber       String?
  status            IntegrationStatus       @default(DISCONNECTED)
  enabled           Boolean                 @default(true)
  isDefault         Boolean                 @default(false)
  lastCheckedAt     DateTime?
  lastError         String?                 @db.VarChar(500)
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  tenant            Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unit              Unit                    @relation(fields: [tenantId, unitId], references: [tenantId, id], onDelete: Cascade)
  events            EvolutionWebhookEvent[]

  @@unique([tenantId, id])
  @@index([tenantId, unitId, status])
}

model EvolutionWebhookEvent {
  id                String              @id @default(uuid()) @db.Uuid
  tenantId          String              @db.Uuid
  connectionId      String              @db.Uuid
  eventKey          String
  eventType         String
  payload           Json
  status            String              @default("PENDING")
  attempts          Int                 @default(0)
  enqueuedAt        DateTime?
  nextAttemptAt     DateTime            @default(now())
  receivedAt        DateTime            @default(now())
  processedAt       DateTime?
  lastError         String?             @db.VarChar(500)
  providerMessageId String?
  tenant            Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  connection        EvolutionConnection @relation(fields: [tenantId, connectionId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, connectionId, eventKey])
  @@index([status, enqueuedAt, nextAttemptAt, receivedAt])
}

model MetaWebhookEvent {
  id                String         @id @default(uuid()) @db.Uuid
  tenantId          String         @db.Uuid
  connectionId      String         @db.Uuid
  eventKey          String
  eventType         String
  payload           Json
  status            String         @default("PENDING")
  attempts          Int            @default(0)
  enqueuedAt        DateTime?
  nextAttemptAt     DateTime       @default(now())
  receivedAt        DateTime       @default(now())
  processedAt       DateTime?
  lastError         String?        @db.VarChar(500)
  providerMessageId String?
  providerTimestamp BigInt?
  tenant            Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  connection        MetaConnection @relation(fields: [tenantId, connectionId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, connectionId, eventKey])
  @@index([status, nextAttemptAt, receivedAt])
  @@index([status, enqueuedAt, nextAttemptAt, receivedAt], map: "MetaWebhookEvent_enqueue_recovery_idx")
  @@index([tenantId, connectionId, providerMessageId, providerTimestamp])
}

model ConsentPreference {
  id                String               @id @default(uuid()) @db.Uuid
  tenantId          String               @db.Uuid
  patientId         String               @db.Uuid
  channel           ConsentChannel
  purpose           ConsentPurpose
  status            ConsentStatus
  source            ConsentSource
  evidence          String?
  evidenceType      ConsentEvidenceType?
  evidenceReference String?
  policyVersion     String?
  lastChangedAt     DateTime             @default(now())
  tenant            Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient           Patient              @relation(fields: [tenantId, patientId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, patientId, channel, purpose])
  @@index([tenantId, channel, purpose, status])
}

model ConsentEvent {
  id                String               @id @default(uuid()) @db.Uuid
  tenantId          String               @db.Uuid
  patientId         String               @db.Uuid
  actorUserId       String?              @db.Uuid
  channel           ConsentChannel
  purpose           ConsentPurpose
  status            ConsentStatus
  source            ConsentSource
  evidence          String?
  evidenceType      ConsentEvidenceType?
  evidenceReference String?
  policyVersion     String?
  occurredAt        DateTime             @default(now())
  tenant            Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient           Patient              @relation(fields: [tenantId, patientId], references: [tenantId, id], onDelete: Cascade)
  actor             User?                @relation("ConsentActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, patientId, occurredAt])
}

model Procedure {
  id                         String                         @id @default(uuid()) @db.Uuid
  tenantId                   String                         @db.Uuid
  unitId                     String?                        @db.Uuid
  name                       String
  appointmentDurationMinutes Int
  returnAfterDays            Int?
  reminderAdvanceDays        Int?
  active                     Boolean                        @default(true)
